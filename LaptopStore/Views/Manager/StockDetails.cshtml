@using System.Globalization
@using LaptopStore.DTOs.StockDTOs
@model StockInOrderResponse

@{
    ViewData["Title"] = "Chi tiết phiếu nhập kho";
    ViewData["Subtitle"] = "Kiểm tra thông tin chi tiết của lô hàng";
    Layout = User.IsInRole("staff") ? "~/Views/Shared/_StaffLayout.cshtml" : "~/Views/Shared/_AdminLayout.cshtml";

    // Xử lý màu sắc trạng thái
    var statusClass = Model.Status.ToLower() switch
    {
        "success" => "bg-success",
        "pending" => "bg-pending",
        "cancel" => "bg-fail",
        _ => "bg-secondary"
    };

    var statusText = Model.Status.ToLower() switch
    {
        "success" => "Đã hoàn thành",
        "pending" => "Đang chờ xử lý",
        "cancel" => "Đã hủy",
        _ => Model.Status.ToUpper()
    };
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            @if (Model.Status.ToLower() == "pending")
            {
                @* <button class="btn btn-success btn-sm ms-2">
                    <i class="fas fa-check me-1"></i> Xác nhận nhập kho
                </button> *@
                <button class="btn btn-danger btn-sm ms-2" type="button" data-bs-toggle="modal" data-bs-target="#deleteModal">
                    <i class="fas fa-x me-1"></i> Hủy đơn nhập kho
                </button>
            }
        </div>
    </div>

    <div class="card shadow-sm invoice-card">
        <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
            <h4 class="mb-0 fw-bold text-primary">
                <i class="fas fa-file-invoice me-2"></i>Phiếu nhập kho #@(Model.Id.ToString().PadLeft(5, '0'))
            </h4>
            <span class="badge @statusClass px-3 py-2" style="font-size: 0.85rem;">
                @statusText
            </span>
        </div>

        <div class="card-body p-4">
            <div class="row mb-5">
                <div class="col-sm-4">
                    <h6 class="text-muted text-uppercase fw-bold mb-3" style="font-size: 0.8rem;">Thông tin chứng từ</h6>
                    <table class="table table-sm table-borderless info-table">
                        <tr>
                            <td class="text-muted w-50">Ngày tạo:</td>
                            <td class="fw-medium">@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                        </tr>
                        <tr>
                            <td class="text-muted">Ngày thực nhập:</td>
                            <td class="fw-medium">@(Model.DeliveredAt?.ToString("dd/MM/yyyy HH:mm") ?? "---")</td>
                        </tr>
                    </table>
                </div>

                <div class="col-sm-4">
                    <h6 class="text-muted text-uppercase fw-bold mb-3" style="font-size: 0.8rem;">Nhà cung cấp</h6>
                    <div class="fw-bold fs-6 text-dark mb-1">@Model.SupplierName</div>
                </div>

                <div class="col-sm-4">
                    <h6 class="text-muted text-uppercase fw-bold mb-3" style="font-size: 0.8rem;">Nhân viên phụ trách</h6>
                    <div class="d-flex align-items-center p-2 bg-light rounded border-start border-4 border-primary">
                        <img src="@(string.IsNullOrEmpty(Model.StaffAvatarUrl) ? "/images/image-not-found.jpg" : Model.StaffAvatarUrl)"
                             alt="Avatar"
                             class="rounded-circle border border-2 border-white shadow-sm"
                             style="width: 50px; height: 50px; object-fit: cover;">
                        <div class="ms-3">
                            <div class="fw-bold fs-6 text-dark mb-1">@Model.StaffName</div>
                            <div class="text-muted small">
                                <i class="fas fa-envelope me-1 text-secondary"></i> @Model.StaffEmail
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <h6 class="text-muted text-uppercase fw-bold mb-3" style="font-size: 0.8rem;">Chi tiết sản phẩm</h6>
            <div class="table-responsive mb-4">
                <table class="table table-hover table-bordered align-middle">
                    <thead class="table-light">
                        <tr>
                            <th class="text-center" style="width: 50px;">STT</th>
                            <th style="width: 60px;">Hình</th>
                            <th>Sản phẩm</th>
                            <th class="text-end">Giá nhập (VNĐ)</th>
                            <th class="text-center">SL Yêu cầu</th>
                            <th class="text-center">SL Thực nhập</th>
                            <th class="text-end">Thành tiền (VNĐ)</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Items != null && Model.Items.Any())
                        {
                            int stt = 1;
                            foreach (var item in Model.Items)
                            {
                                var itemTotal = item.ImportPrice.HasValue ? item.ImportPrice.Value * item.ActualQuantity : 0;

                                <tr>
                                    <td class="text-center text-muted">@(stt++)</td>
                                    <td>
                                        <img src="@(string.IsNullOrEmpty(item.ImageUrl) ? "/images/image-not-found.jpg" : item.ImageUrl)"
                                             class="rounded border bg-white" style="width: 40px; height: 40px; object-fit: cover;">
                                    </td>
                                    <td>
                                        <a asp-controller="ProductManagement" asp-action="ProductDetails" asp-route-id="@item.ProductId"
                                           class="text-decoration-none fw-bold text-dark">
                                            @item.ProductName
                                        </a>
                                        <div class="small text-muted">SKU: SP-@item.ProductId.ToString().PadLeft(4, '0')</div>
                                    </td>

                                    <td class="text-end fw-medium text-nowrap">
                                        @(item.ImportPrice?.ToString("N0", new CultureInfo("vi-VN")) ?? "---")đ
                                    </td>

                                    <td class="text-center">
                                        <span class="text-muted">@item.RequestedQuantity</span>
                                    </td>
                                    <td class="text-center">
                                        @if (item.ActualQuantity < item.RequestedQuantity)
                                        {
                                            <span class="badge bg-fail">@item.ActualQuantity</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success">@item.ActualQuantity</span>
                                        }
                                    </td>

                                    <td class="text-end fw-bold text-dark text-nowrap">
                                        @itemTotal.ToString("N0", new CultureInfo("vi-VN"))đ
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center py-4 text-muted">
                                    <i class="fas fa-box-open fs-3 mb-2 d-block"></i>
                                    Phiếu nhập kho này chưa có sản phẩm nào.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="row justify-content-end">
                <div class="col-sm-6 col-md-5">
                    <table class="table table-sm table-borderless">
                        <tr>
                            <td class="text-muted text-end">Tổng số lượng nhập:</td>
                            <td class="text-end fw-bold" style="width: 120px;">
                                @(Model.Items?.Sum(i => i.ActualQuantity) ?? 0)
                            </td>
                        </tr>
                        <tr class="border-top">
                            <td class="text-end fw-bold fs-5 pt-3">TỔNG TIỀN:</td>
                            <td class="text-end fw-bold text-danger fs-5 pt-3 text-nowrap">
                                @(Model.TotalCost?.ToString("N0", new CultureInfo("vi-VN")) ?? "0") đ
                            </td>
                        </tr>
                    </table>
                </div>
            </div>

        </div>
    </div>
</div>

<div class="modal fade" id="deleteModal" tabindex="-1" role="dialog" aria-labelledby="deleteModalLabel" aria-hidden="true" style="height:auto">
    <div class="modal-dialog" role="document" style="margin:unset">
        <div class="modal-content" style="border:none">
            <div class="modal-header">
                <h5 class="modal-title" id="deleteModalLabel">Xóa đơn nhập kho</h5>
            </div>
            <div class="modal-body">
                Bạn có chắc chắn muốn xóa đơn nhập kho này không? Hành động này không thể hoàn tác và sẽ xóa tất cả thông tin liên quan đến đơn hàng.
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                <form asp-action="CancelPendingReceipt" method="post" asp-route-id="@Model.Id">
                    <button type="submit" class="btn btn-danger">Xóa</button>
                </form>
            </div>
            }
        </div>
    </div>
</div>