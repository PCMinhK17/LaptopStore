@model LaptopStore.Models.Order

@{
    ViewData["Title"] = $"Chi tiết đơn hàng #{Model.Id:D6}";
    ViewData["Subtitle"] = "Thông tin chi tiết đơn đặt hàng";
    Layout = User.IsInRole("staff") ? "~/Views/Shared/_StaffLayout.cshtml" : "~/Views/Shared/_AdminLayout.cshtml";

    var statusClass = Model.Status switch
    {
        "pending" => "badge-warning",
        "processing" => "badge-info",
        "shipping" => "badge-primary",
        "delivered" => "badge-success",
        "cancelled" => "badge-danger",
        _ => "badge-light"
    };
    var statusText = Model.Status switch
    {
        "pending" => "Chờ xác nhận",
        "processing" => "Đang xử lý",
        "shipping" => "Đang giao hàng",
        "delivered" => "Đã giao hàng",
        "cancelled" => "Đã hủy",
        _ => Model.Status
    };
    var paymentClass = Model.PaymentStatus switch
    {
        "paid" => "badge-success",
        "unpaid" => "badge-warning",
        "refunded" => "badge-info",
        _ => "badge-light"
    };
    var paymentText = Model.PaymentStatus switch
    {
        "paid" => "Đã thanh toán",
        "unpaid" => "Chưa thanh toán",
        "refunded" => "Đã hoàn tiền",
        _ => Model.PaymentStatus
    };
    var paymentMethodText = Model.PaymentMethod switch
    {
        "cod" => "Thanh toán khi nhận hàng (COD)",
        "vietqr" => "Chuyển khoản ngân hàng",
        "vnpay" => "Ví điện tử VNPay",
        _ => Model.PaymentMethod
    };
}

<link rel="stylesheet" href="~/css/checkout.css" />

<div class="container py-5">
    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <div>
                <h3 class="mb-0">Đơn hàng #@Model.Id</h3>
                <small class="text-muted">Trạng thái: @Model.Status</small>
            </div>
            <div class="text-end">
                <small>Ngày đặt: @Model.CreatedAt.ToString("dd.MM.yyyy HH:mm")</small>
            </div>
        </div>
        <div class="card-body">
            <div class="mb-3">
                <strong>Người nhận:</strong> @Model.FullName<br />
                <strong>Điện thoại:</strong> @Model.PhoneNumber<br />
                <strong>Địa chỉ:</strong> @Model.Address
            </div>

            <div class="mb-3">
                <strong>Phương thức thanh toán:</strong> 
                @if (Model.PaymentMethod == "qr")
                {
                    <span>Chuyển khoản ngân hàng (SEPay)</span>
                }
                else if (Model.PaymentMethod == "cod")
                {
                    <span>Thanh toán khi nhận hàng (COD)</span>
                }
                else
                {
                    @Model.PaymentMethod
                }
                <br />
                <strong>Trạng thái thanh toán:</strong>
                @if (Model.PaymentStatus == "paid")
                {
                    <span class="text-success fw-bold"><i class="fas fa-check-circle me-1"></i>Đã thanh toán</span>
                }
                else
                {
                    <span class="text-danger fw-bold"><i class="fas fa-exclamation-circle me-1"></i>Chưa thanh toán</span>
                }
            </div>

            @if (Model.PaymentMethod == "qr" && Model.PaymentStatus == "unpaid")
            {
                var bankId = ViewBag.SePayBankId;
                var accountNo = ViewBag.SePayAccountNo;
                var accountName = ViewBag.SePayAccountName;
                var amount = Model.TotalMoney.ToString("0");
                var addInfo = "Thanh toan don hang " + Model.Id;
                
                // Sử dụng trình tạo QR của SEPay
                var qrUrl = $"https://qr.sepay.vn/img?acc={accountNo}&bank={bankId}&amount={amount}&des={addInfo}";

                <div class="card mb-4 border-primary">
                    <div class="card-header bg-primary text-white">
                        <h5 class="mb-0"><i class="fas fa-qrcode me-2"></i>Thông tin chuyển khoản</h5>
                    </div>
                    <div class="card-body text-center">
                        <p>Vui lòng quét mã QR dưới đây qua ứng dụng ngân hàng của bạn để thanh toán:</p>
                        <img src="@qrUrl" alt="VietQR SEPay" class="img-fluid mb-3 shadow-sm border" style="max-width: 300px; border-radius: 8px;" />
                        <div class="text-start" style="max-width: 400px; margin: 0 auto; background: #f8f9fa; padding: 15px; border-radius: 8px;">
                            <p class="mb-1"><strong>Ngân hàng:</strong> @bankId</p>
                            <p class="mb-1"><strong>Số tài khoản:</strong> <span class="fw-bold text-primary">@accountNo</span></p>
                            <p class="mb-1"><strong>Chủ tài khoản:</strong> @accountName</p>
                            <p class="mb-1"><strong>Số tiền:</strong> <span class="text-danger fw-bold">@Model.TotalMoney.ToString("N0") đ</span></p>
                            <p class="mb-0"><strong>Nội dung:</strong> <span class="fw-bold">@addInfo</span></p>
                        </div>
                        
                        <div class="mt-3 alert alert-info text-start d-flex align-items-center" id="paymentStatusAlert">
                            <div class="spinner-border spinner-border-sm text-primary me-2" role="status">
                                <span class="visually-hidden">Loading...</span>
                            </div>
                            <span>Hệ thống đang chờ thanh toán. Trạng thái sẽ được cập nhật tự động. (Kiểm tra mỗi 5s)</span>
                        </div>
                        
                        <button id="btnCheckPayment" class="btn btn-outline-primary mt-2">
                            <i class="fas fa-sync-alt me-1"></i> Tôi đã chuyển khoản (Kiểm tra ngay)
                        </button>
                    </div>
                </div>

                <script>
                    function checkPaymentStatus(isManual = false) {
                        const btn = document.getElementById('btnCheckPayment');
                        if (isManual && btn) {
                            btn.innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i> Đang kiểm tra...';
                            btn.disabled = true;
                        }

                        fetch('/Order/CheckPaymentStatus?orderId=@Model.Id')
                            .then(response => response.json())
                            .then(data => {
                                if (data.success && data.isPaid) {
                                    const alertBox = document.getElementById('paymentStatusAlert');
                                    alertBox.className = 'mt-3 alert alert-success text-start';
                                    alertBox.innerHTML = '<i class="fas fa-check-circle me-2"></i> Thanh toán thành công! Trình duyệt sẽ tự động tải lại trang...';
                                    
                                    if (btn) btn.style.display = 'none';

                                    setTimeout(() => {
                                        window.location.reload();
                                    }, 2000);
                                } else {
                                    if (isManual && btn) {
                                        setTimeout(() => {
                                            btn.innerHTML = '<i class="fas fa-sync-alt me-1"></i> Tôi đã chuyển khoản (Kiểm tra ngay)';
                                            btn.disabled = false;
                                        }, 500); // delay một chút cho người dùng thấy có bấm
                                    }
                                }
                            })
                            .catch(error => {
                                console.error('Error checking payment:', error);
                                if (isManual && btn) {
                                    btn.innerHTML = '<i class="fas fa-sync-alt me-1"></i> Tôi đã chuyển khoản (Kiểm tra ngay)';
                                    btn.disabled = false;
                                }
                            });
                    }

                    // Polling mỗi 5 giây
                    const poller = setInterval(() => checkPaymentStatus(false), 5000);

                    // Khi người dùng bấm nút kiểm tra
                    document.addEventListener('DOMContentLoaded', function() {
                        const btnCheck = document.getElementById('btnCheckPayment');
                        if (btnCheck) {
                            btnCheck.addEventListener('click', () => checkPaymentStatus(true));
                        }
                    });
                </script>
            }

            <div class="mb-3">
                <strong>Dự kiến giao hàng:</strong>
                @if (estFrom.HasValue && estTo.HasValue)
                {
                    <span class="text-success">@estFrom.Value.ToString("dd.MM.yyyy") - @estTo.Value.ToString("dd.MM.yyyy")</span>
                }
            </div>
        </div>

        <!-- Order Items -->
        <div class="card mb-4">
            <div class="card-header">
                <h5 class="card-title">
                    <i class="fas fa-box"></i>
                    Sản phẩm đặt mua
                    <span class="badge badge-light ms-2">@Model.OrderDetails?.Count sản phẩm</span>
                </h5>
            </div>
            <div class="table-container">
                <table class="table">
                    <thead>
                        <tr>
                            <th>Sản phẩm</th>
                            <th class="text-center">Số lượng</th>
                            <th class="text-end">Đơn giá</th>
                            <th class="text-end">Thành tiền</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.OrderDetails != null)
                        {
                            foreach (var item in Model.OrderDetails)
                            {
                                var product = item.Product;
                                var thumbnail = product?.ProductImages?.FirstOrDefault(i => i.IsThumbnail ?? false)?.ImageUrl ?? "/images/default-product.png";
                                var itemTotal = item.Quantity * item.Price;

                                <tr>
                                    <td>
                                        <div class="table-product">
                                            <div class="table-product-img">
                                                <img src="@thumbnail" alt="@product?.Name" />
                                            </div>
                                            <div class="table-product-info">
                                                <div class="table-product-name">
                                                    <a asp-controller="Product"
                                                       asp-action="Detail"
                                                       asp-route-id="@product?.Id"
                                                       style="color: var(--text-primary); text-decoration:none; font-weight:600;">
                                                        @product?.Name
                                                    </a>
                                                </div>
                                                <div class="table-product-sku">SKU: @product?.Sku</div>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge badge-light">x@item.Quantity</span>
                                    </td>
                                    <td class="text-end">@item.Price.ToString("#,##0") ₫</td>
                                    <div class="d-flex justify-content-between pt-2 border-top">
                                        <span class="fw-bold">Total Order Amount:</span>
                                        <span class="fw-bold text-primary" style="font-size: 1.25rem;">
                                            @Model.TotalMoney.ToString("#,##0") ₫
                                        </span>
                                    </div>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
            <div class="card-footer">
                <div class="row justify-content-end">
                    <div class="col-12 col-md-6">
                        <div class="d-flex flex-column gap-2">
                            <div class="d-flex justify-content-between">
                                <span class="text-muted">Tạm tính:</span>
                                <span>@Model.Subtotal?.ToString("#,##0") ₫</span>
                            </div>
                            <div class="d-flex justify-content-between">
                                <span class="text-muted">Phí vận chuyển:</span>
                                <span>Miễn phí</span>
                            </div>
                            <div class="d-flex justify-content-between pt-2 border-top">
                                <span class="fw-bold">Tổng cộng:</span>
                                <span class="fw-bold text-primary" style="font-size: 1.25rem;">@Model.TotalMoney.ToString("#,##0") ₫</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Order Details Sidebar -->
    <div class="col-12 col-lg-4">
        <!-- Customer Info -->
        <div class="card mb-4">
            <div class="card-header">
                <h5 class="card-title">
                    <i class="fas fa-user"></i>
                    Thông tin khách hàng
                </h5>
            </div>
            <div class="card-body">
                <div class="d-flex flex-column gap-3">
                    <div>
                        <label class="form-label mb-1">Họ tên</label>
                        <div class="fw-semibold">@Model.FullName</div>
                    </div>
                    <div>
                        <label class="form-label mb-1">Số điện thoại</label>
                        <div class="fw-semibold">
                            <a href="tel:@Model.PhoneNumber" style="color: var(--text-primary); text-decoration: none;">
                                <i class="fas fa-phone-alt text-muted me-2"></i>@Model.PhoneNumber
                            </a>
                        </div>
                    </div>
                    @if (Model.User != null)
                    {
                        <div>
                            <label class="form-label mb-1">Email</label>
                            <div>
                                <a href="mailto:@Model.User.Email" style="color: var(--primary-600); text-decoration: none;">
                                    <i class="fas fa-envelope text-muted me-2"></i>@Model.User.Email
                                </a>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

            <div class="text-end">
                <p>Tạm tính: <strong>@Model.Subtotal.ToString("N0") đ</strong></p>
                <h4>Tổng thanh toán: <strong>@Model.TotalMoney.ToString("N0") đ</strong></h4>
            </div>
            <div class="card-body">
                <p class="mb-0">@Model.Address</p>
                @if (!string.IsNullOrEmpty(Model.Note))
                {
                    <div class="mt-3 pt-3 border-top">
                        <label class="form-label mb-1">Ghi chú</label>
                        <p class="mb-0 text-muted">@Model.Note</p>
                    </div>
                }
            </div>
        </div>

        <!-- Payment Info -->
        <div class="card mb-4">
            <div class="card-header">
                <h5 class="card-title">
                    <i class="fas fa-credit-card"></i>
                    Thanh toán
                </h5>
            </div>
            <div class="card-body">
                <div class="d-flex flex-column gap-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="text-muted">Phương thức</span>
                        <span class="fw-semibold">@paymentMethodText</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="text-muted">Trạng thái</span>
                        <span class="badge @paymentClass">@paymentText</span>
                    </div>
                    @if (Model.PaymentStatus == "unpaid" && Model.Status != "cancelled")
                    {
                        <div class="mt-2">
                            <button type="button" class="btn btn-sm btn-success w-100" onclick="markAsPaid()">
                                <i class="fas fa-check me-1"></i> Đánh dấu đã thanh toán
                            </button>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Order Meta -->
        <div class="card">
            <div class="card-header">
                <h5 class="card-title">
                    <i class="fas fa-clock"></i>
                    Thời gian
                </h5>
            </div>
            <div class="card-body">
                <div class="d-flex flex-column gap-2">
                    <div class="d-flex justify-content-between">
                        <span class="text-muted">Ngày đặt</span>
                        <span>@Model.CreatedAt?.ToString("dd/MM/yyyy HH:mm")</span>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .order-timeline {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 20px 0;
    }

    .timeline-step {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 10px;
        flex: 0 0 auto;
    }

    .timeline-step-dot {
        width: 48px;
        height: 48px;
        border-radius: 50%;
        background: var(--bg-tertiary);
        border: 2px solid var(--border-color);
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--text-muted);
        font-size: 1.1rem;
        transition: all var(--transition-normal);
    }

    .timeline-step.completed .timeline-step-dot {
        background: var(--success-100);
        border-color: var(--success-500);
        color: var(--success-600);
    }

    .timeline-step.active .timeline-step-dot {
        background: var(--primary-100);
        border-color: var(--primary-500);
        color: var(--primary-600);
        box-shadow: 0 0 0 4px var(--primary-100);
    }

    .timeline-step-label {
        font-size: 0.8rem;
        color: var(--text-muted);
        font-weight: 500;
    }

    .timeline-step.completed .timeline-step-label,
    .timeline-step.active .timeline-step-label {
        color: var(--text-primary);
    }

    .timeline-connector {
        flex: 1;
        height: 3px;
        background: var(--border-color);
        margin: 0 8px;
        margin-bottom: 30px;
        border-radius: 2px;
    }

        .timeline-connector.completed {
            background: var(--success-500);
        }

    @@media (max-width: 576px) {
        .timeline-step-dot {
            width: 36px;
            height: 36px;
            font-size: 0.9rem;
        }

        .timeline-step-label {
            font-size: 0.7rem;
        }
    }

    @@media print {
        .btn, .sidebar, .topbar {
            display: none !important;
        }

        .main-content {
            margin-left: 0 !important;
            padding-top: 0 !important;
        }
    }
</style>

@section Scripts {
    <script>
        function updateStatus(newStatus) {
            const statusText = {
                'processing': 'xác nhận',
                'shipping': 'chuyển sang giao hàng',
                'delivered': 'đánh dấu đã giao'
            };

            if (!confirm(`Bạn có chắc chắn muốn ${statusText[newStatus]} đơn hàng này?`)) {
                return;
            }

            fetch('/OrderManagement/UpdateStatus', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
                },
                body: `id=@Model.Id&status=${newStatus}`
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    location.reload();
                } else {
                    alert(data.message || 'Có lỗi xảy ra');
                }
            })
            .catch(error => {
                console.error('Error:', error);
                alert('Có lỗi xảy ra khi cập nhật trạng thái');
            });
        }

        function cancelOrder() {
            if (!confirm('Bạn có chắc chắn muốn hủy đơn hàng này? Hành động này không thể hoàn tác.')) {
                return;
            }

            fetch('/OrderManagement/UpdateStatus', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
                },
                body: `id=@Model.Id&status=cancelled`
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    location.reload();
                } else {
                    alert(data.message || 'Có lỗi xảy ra');
                }
            })
            .catch(error => {
                console.error('Error:', error);
                alert('Có lỗi xảy ra khi hủy đơn hàng');
            });
        }

        function markAsPaid() {
            if (!confirm('Xác nhận đơn hàng đã được thanh toán?')) {
                return;
            }

            fetch('/OrderManagement/UpdatePaymentStatus', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
                },
                body: `id=@Model.Id&paymentStatus=paid`
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    location.reload();
                } else {
                    alert(data.message || 'Có lỗi xảy ra');
                }
            })
            .catch(error => {
                console.error('Error:', error);
                alert('Có lỗi xảy ra khi cập nhật thanh toán');
            });
        }
    </script>
}
