@model LaptopStore.Models.Order

@{
    ViewData["Title"] = $"Chi tiết đơn hàng #{Model.Id:D6}";


var statusClass = Model.Status?.ToLower() switch
{
    "pending" => "badge bg-warning",
    "confirmed" => "badge bg-info",
    "shipping" => "badge bg-primary",
    "completed" => "badge bg-success",
    "cancelled" => "badge bg-danger",
    _ => "badge bg-secondary"
};

    var statusText = Model.Status?.ToLower() switch
    {
        "pending" => "Chờ xác nhận",
        "confirmed" => "Đã xác nhận",
        "shipping" => "Đang giao",
        "completed" => "Hoàn thành",
        "cancelled" => "Đã hủy",
        _ => Model.Status
    };

    var paymentText = Model.PaymentStatus switch
    {
        "paid" => "Đã thanh toán",
        "unpaid" => "Chưa thanh toán",
        "refunded" => "Đã hoàn tiền",
        _ => Model.PaymentStatus
    };

    var paymentMethodText = Model.PaymentMethod switch
    {
        "cod" => "Thanh toán khi nhận hàng",
        "qr" => "Chuyển khoản",
        "vnpay" => "VNPay",
        _ => Model.PaymentMethod
    };

    var totalQuantity = Model.OrderDetails?.Sum(x => x.Quantity) ?? 0;
}

@Html.AntiForgeryToken()

<div class="container mt-4">

    <!-- HEADER -->
    <div class="d-flex justify-content-between mb-3">
        <a href="/Order/OrderHistory" class="btn btn-secondary btn-sm">
            ← Quay lại
        </a>

        <div>
            @if (Model.PaymentStatus == "unpaid" && Model.Status?.ToLower() != "cancelled")
            {
                <a href="/Order/Details/@Model.Id" class="btn btn-primary btn-sm me-2">
                    Thanh toán
                </a>
            }

            @if (Model.Status?.ToLower() == "pending" || Model.Status?.ToLower() == "confirmed")
            {
                <button class="btn btn-danger btn-sm" onclick="cancelOrder()">
                    Hủy đơn
                </button>
            }
        </div>
    </div>

    <div class="row">

        <!-- LEFT -->
        <div class="col-md-8">

            <!-- ORDER INFO -->
            <div class="card mb-3">
                <div class="card-body d-flex justify-content-between">
                    <div>
                        <h5>Đơn hàng #@Model.Id</h5>
                        <div>@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</div>
                    </div>
                    <div class="text-end">
                        <div class="@statusClass">@statusText</div>
                        <small>@paymentText</small>
                    </div>
                </div>
            </div>

            <!-- PRODUCTS -->
            <div class="card mb-3">
                <div class="card-header">
                    Sản phẩm (@totalQuantity)
                </div>

                <div class="table-responsive">
                    <table class="table align-middle">
                        <thead>
                            <tr>
                                <th>Sản phẩm</th>
                                <th class="text-center">SL</th>
                                <th class="text-end">Giá</th>
                                <th class="text-end">Tổng</th>
                            </tr>
                        </thead>

                        <tbody>
                            @if (Model.OrderDetails != null && Model.OrderDetails.Any())
                            {
                                foreach (var item in Model.OrderDetails)
                                {
                                    var p = item.Product;
                                    var img = p?.ProductImages?.FirstOrDefault(i => i.IsThumbnail == true)?.ImageUrl ?? "/images/default-product.png";
                                    var total = item.Quantity * item.Price;

                                    <tr>
                                        <td>
                                            <div class="d-flex gap-2">
                                                <img src="@img" style="width:60px;height:60px;object-fit:cover;border-radius:6px" />

                                                <div>
                                                    <div>
                                                        <a asp-controller="Product" asp-action="Detail" asp-route-id="@p?.Id">
                                                            @p?.Name
                                                        </a>
                                                    </div>
                                                    <small>SKU: @p?.Sku</small>
                                                </div>
                                            </div>
                                        </td>

                                        <td class="text-center">@item.Quantity</td>

                                        <td class="text-end">
                                            @item.Price.ToString("#,##0") ₫
                                        </td>

                                        <td class="text-end text-danger fw-bold">
                                            @total.ToString("#,##0") ₫
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="4" class="text-center text-muted">
                                        Không có sản phẩm
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- TOTAL -->
                <div class="card-footer bg-light">
                    <div class="text-end">

                        <div>Tạm tính: <strong>@Model.Subtotal.ToString("N0") ₫</strong></div>

                        @if (!string.IsNullOrEmpty(Model.CouponCode))
                        {
                            <div class="text-success">
                                Giảm giá (@Model.CouponCode):
                                -@Model.DiscountAmount.ToString("N0") ₫
                            </div>
                        }

                        <div>Ship: Miễn phí</div>

                        <h5 class="text-danger mt-2">
                            Tổng: @Model.TotalMoney.ToString("N0") ₫
                        </h5>
                    </div>
                </div>
            </div>

        </div>

        <!-- RIGHT -->
        <div class="col-md-4">

            <!-- CUSTOMER -->
            <div class="card mb-3">
                <div class="card-header">Khách hàng</div>
                <div class="card-body">
                    <div><strong>@Model.FullName</strong></div>
                    <div>@Model.PhoneNumber</div>
                    <div>@Model.Address</div>
                </div>
            </div>

            <!-- PAYMENT -->
            <div class="card mb-3">
                <div class="card-header">Thanh toán</div>
                <div class="card-body">
                    <div>Phương thức: <strong>@paymentMethodText</strong></div>
                    <div>Trạng thái: <strong>@paymentText</strong></div>
                </div>
            </div>

            <!-- NOTE -->
            @if (!string.IsNullOrEmpty(Model.Note))
            {
                <div class="card">
                    <div class="card-header">Ghi chú</div>
                    <div class="card-body">
                        @Model.Note
                    </div>
                </div>
            }

        </div>

    </div>
    ```

</div>

<script>
    function cancelOrder() {
        if (!confirm("Bạn chắc chắn muốn hủy đơn?")) return;

        fetch('/Order/Cancel', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ id: @Model.Id })
        })
        .then(res => res.json())
        .then(data => {
            if (data.success || data.Success) location.reload();
            else alert("Lỗi: " + (data.message || data.Message || "Không thể hủy đơn"));
        })
        .catch(err => {
            console.error(err);
            alert("Đã xảy ra lỗi hệ thống!");
        });
    }
</script>
