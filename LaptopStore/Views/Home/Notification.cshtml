@model IEnumerable<LaptopStore.Models.Notification>
@{
    ViewData["Title"] = "Thông báo của bạn";

    if (User.IsInRole("staff"))
    {
        Layout = "~/Views/Shared/_StaffLayout.cshtml";
    }
    else if (User.IsInRole("admin"))
    {
        Layout = "~/Views/Shared/_AdminLayout.cshtml";
    }

    var unreadIds = ViewBag.UnreadIds as List<int> ?? new List<int>();
}

<style>
    .notification-list .list-group-item {
        transition: all 0.2s ease-in-out;
        border-left: 4px solid transparent;
    }

        .notification-list .list-group-item:hover {
            background-color: #f8f9fa;
        }
    .notification-unread {
        background-color: #f0f7ff;
        border-left-color: #0d6efd !important;
    }

    .icon-circle {
        width: 48px;
        height: 48px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        font-size: 1.2rem;
    }

    .text-truncate-2 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
</style>

<div class="container my-4 my-md-5" style="max-width: 800px;">

    <div class="d-flex justify-content-between align-items-end mb-4">
        <div>
            <h3 class="fw-bold mb-1">Thông báo</h3>
            <p class="text-muted mb-0">Cập nhật những thông tin mới nhất về đơn hàng và tài khoản của bạn.</p>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        @if (Model != null && Model.Any())
        {
            <div class="list-group list-group-flush notification-list">
                @foreach (var item in Model)
                {
                    var iconClass = "fas fa-bell";
                    var bgClass = "bg-secondary text-white";

                    switch (item.Type?.ToLower())
                    {
                        case "order":
                            iconClass = "fas fa-box-open";
                            bgClass = "bg-success text-white"; 
                            break;
                        case "receipt":
                            iconClass = "fas fa-receipt";
                            bgClass = "bg-primary text-white"; 
                            break;
                        default:
                            iconClass = "fas fa-info";
                            bgClass = "bg-primary text-white";
                            break;
                    }

                    <a href="#" class="list-group-item list-group-item-action p-3 p-md-4 @(unreadIds.Contains(item.Id) ? "notification-unread" : "")">
                        <div class="d-flex align-items-start gap-3 gap-md-4">

                            <div class="icon-circle shadow-sm @bgClass flex-shrink-0">
                                <i class="@iconClass"></i>
                            </div>

                            <div class="flex-grow-1">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <h6 class="mb-0 @(!item.IsRead ? "fw-bold text-dark" : "fw-medium text-secondary")">
                                        @item.Title
                                    </h6>

                                    <small class="text-muted ms-2 text-nowrap">
                                        @(item.CreatedAt.HasValue? item.CreatedAt.Value.ToString("dd/MM/yyyy HH:mm") : "")
                                    </small>
                                </div>

                                <p class="mb-0 text-muted small text-truncate-2">
                                    @item.Message
                                </p>
                            </div>

                            @if (unreadIds.Contains(item.Id))
                            {
                                <div class="flex-shrink-0 d-flex align-items-center h-100 mt-2">
                                    <span class="p-1 bg-primary border border-light rounded-circle" style="width: 10px; height: 10px;"></span>
                                </div>
                            }
                        </div>
                    </a>
                }
            </div>
        }
        else
        {
            <div class="card-body text-center py-5">
                <div class="mb-3">
                    <i class="fas fa-bell-slash text-muted" style="font-size: 3rem; opacity: 0.5;"></i>
                </div>
                <h5 class="fw-medium text-dark">Bạn chưa có thông báo nào</h5>
                <p class="text-muted">Khi có cập nhật về đơn hàng hoặc khuyến mãi, chúng sẽ xuất hiện ở đây.</p>
                <a href="/" class="btn btn-primary rounded-pill px-4 mt-2">Tiếp tục mua sắm</a>
            </div>
        }
    </div>
</div>